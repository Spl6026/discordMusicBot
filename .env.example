BOT_TOKEN=your_discord_bot_token
# Native Python only; Docker Compose sets this to http://bgutil-provider:4416
BGUTIL_PROVIDER_URL=http://127.0.0.1:4416
# Leave empty to let yt-dlp choose its current default clients.
YTDLP_PLAYER_CLIENT=
YTDLP_JS_RUNTIME=deno
# Optional Netscape cookies file, accessible inside the container.
YTDLP_COOKIES_FILE=
# Idle/alone disconnect timeout in real seconds; 0 disables automatic leaving.
IDLE_TIMEOUT_SECONDS=300
